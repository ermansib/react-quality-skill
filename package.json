{
  "name": "react-quality-skill",
  "version": "1.0.0",
  "private": true,
  "description": "Team React + TypeScript quality rules and a matching code reviewer, as Claude skills, Cursor rules and shared configs for Vite and Expo projects.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build:cursor": "node scripts/build-cursor-rules.mjs",
    "check:cursor": "node scripts/build-cursor-rules.mjs --check",
    "package:skill": "node scripts/package-skill.mjs",
    "lint:web": "cd examples/web && eslint -c ../../configs/eslint/eslint.config.web.js --max-warnings 0 .",
    "lint:native": "cd examples/native && eslint -c ../../configs/eslint/eslint.config.native.js --max-warnings 0 .",
    "typecheck": "tsc -p examples/web/tsconfig.json && tsc -p examples/native/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run check:cursor && npm run check:examples && npm run format:check && npm run typecheck && npm run lint:web && npm run lint:native && npm run test:web && npm run test:review",
    "test:web": "cd examples/web && vitest run",
    "test:review": "node --test tests/review/scan.test.mjs",
    "review:scan": "node skills/react-quality-review/scripts/scan.mjs",
    "check:examples": "cmp configs/vite/vite.config.ts examples/web/vite.config.ts && cmp configs/vite/setup.ts examples/web/src/test/setup.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-testing-library": "^7.16.2",
    "expo": "^58.0.23",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
